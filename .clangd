Completion:
    AllScopes: Yes

InlayHints:
    ParameterNames: No
    TypeNameLimit: 10
    DeducedTypes: No
    Designators: No

Diagnostics:
    UnusedIncludes: Strict
    ClangTidy:
        Add:
            - bugprone-*
            - performance-*
            - readability-*
            - modernize-*
        Remove:
            - readability-braces-around-statements

Index:
    Background: Build

CompileFlags:
    Add: [ -std=c++23 ]

Documentation:
    CommentFormat: Markdown