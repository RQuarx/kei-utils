{
    "clangd.arguments": [
        "--header-insertion=never",
        "--compile-commands-dir=target"
    ],
    "mesonbuild.buildFolder": "target",
    "mesonbuild.configureEnvironment": {
        "CXX": "clang++",
        "CXX_LD": "lld"
    },
    "editor.rulers": [
        {
            "column": 100,
            "color": "#229e73"
        },
    ],
    "editor.experimentalWhitespaceRendering": "svg",
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild",
    "C_Cpp.default.compileCommands": "/home/kei/Dev/libkei/target/compile_commands.json",
}